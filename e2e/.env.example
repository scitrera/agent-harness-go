# Your model endpoint. Anything OpenAI-compatible: a local llama.cpp/vLLM/Ollama
# server, or a hosted provider.
SAHARA_LLM_BASE_URL=http://host.docker.internal:11434/v1
SAHARA_LLM_API_KEY=
SAHARA_LLM_MODEL=gpt-4o-mini
SAHARA_LLM_FORMAT=openai

# ── Optional ──────────────────────────────────────────────────────────────
# AETHER_SPECIFIER=e2e
# Enable only when callers create real Aether tasks and receive the gateway's
# subject-task subscription before the worker begins streaming.
# AETHER_TASK_MESSAGE_LANES=false
# MEMORYLAYER_WORKSPACE=default
# The E2E defaults the refinement audit to MemoryLayer; set local only when
# explicitly testing the standalone file authority.
# SAHARA_REFINEMENT_AUTHORITY=memorylayer
# To declare Aether-backed scheduled turns, copy schedules.example.yaml to
# workspace/config/schedules.yaml, enable the desired entries, then set:
# SAHARA_SCHEDULE_CONFIG=/workspace/config/schedules.yaml
# SAHARA_SCHEDULE_RELOAD_INTERVAL=2s

# Named-provider credentials used only when config/models.yaml references them
# through api_key_env (see models.example.yaml):
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Real semantic embeddings (requires `--profile embed` and a FRESH
# memorylayer-data volume — the vector width is fixed when the store is created):
# MEMORYLAYER_EMBEDDING_PROVIDER=embed_server
# MEMORYLAYER_EMBED_SERVER_URL=http://embed-server:61051
# MEMORYLAYER_EMBEDDING_DIMENSIONS=384

# Image overrides. Defaults are the locally-built :local tags (see build.sh);
# point these at published tags once the OSS images ship.
# AETHERLITE_IMAGE=scitrera/aetherlite:local
# MEMORYLAYER_IMAGE=scitrera/memorylayer-server:local
# MEMORYLAYER_EMBED_IMAGE=scitrera/memorylayer-embed-server:local
# AGENT_HARNESS_IMAGE=agent-harness:local
